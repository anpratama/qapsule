{
  "name": "qapsule",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A QoreChain EVM dApp: a Solidity Counter contract deployed and exercised with viem via @qorechain/evm.",
  "scripts": {
    "deploy": "tsx --env-file=.env scripts/deploy.ts",
    "deploy:qapsule": "tsx --env-file=.env scripts/deploy-qapsule.ts",
    "e2e": "tsx --env-file=.env scripts/e2e-onchain.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@noble/post-quantum": "^0.7.1",
    "@qorechain/evm": "^0.14.0",
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  }
}
